# ==============================================================================
# CRYSTAL SPA - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel, Railway, AWS), configure these variables securely
# via your hosting provider's secrets manager. Never commit actual secret keys!
# ==============================================================================

# Node Environment
NODE_ENV=production

# Application URL
NEXT_PUBLIC_SITE_URL=https://crystal-spa.fr

# ------------------------------------------------------------------------------
# STRIPE PAYMENTS (PCI-DSS Compliant)
# ------------------------------------------------------------------------------
# Secret key (server-side only, never prefix with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=sk_live_51...your_stripe_secret_key...
# Webhook signing secret for verifying Stripe event signatures
STRIPE_WEBHOOK_SECRET=whsec_...your_stripe_webhook_secret...
# Publishable key (client-side safe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51...your_stripe_publishable_key...

# ------------------------------------------------------------------------------
# SMOOBU CHANNEL MANAGER API
# ------------------------------------------------------------------------------
# Smoobu API key (server-side only, for calendar sync & direct booking push)
SMOOBU_API_KEY=your_smoobu_api_key_here
SMOOBU_USER_ID=your_smoobu_user_id_here

# ------------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE (Bot & Spam Protection)
# ------------------------------------------------------------------------------
# Turnstile Site Key (Public)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAA...your_site_key...
# Turnstile Secret Key (Server-only)
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAA...your_secret_key...

# ------------------------------------------------------------------------------
# SECURITY & CSRF
# ------------------------------------------------------------------------------
CSRF_SECRET=crystal_spa_super_secret_cryptographic_token_string_32_bytes
